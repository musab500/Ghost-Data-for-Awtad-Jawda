# Copy to .env (gitignored) and fill in. Read by code/multimodal.py; values are never printed.
ANTHROPIC_API_KEY=
# Optional: vision model for the screenshots (default claude-opus-5-5)
MULTIMODAL_MODEL=
# Set to 0 for the final run: only VLM results may satisfy a screenshot
MULTIMODAL_ALLOW_MANUAL=
