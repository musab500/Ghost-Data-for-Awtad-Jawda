# Copy to .env (gitignored) and fill in. Read by code/llm_provider.py (Person B); keys are never printed.
GEMINI_API_KEY=
# Optional: choose the provider explicitly (gemini | anthropic | none)
LLM_PROVIDER=
# Optional: vision model used by code/multimodal.py for the screenshots (provider default if empty)
VISION_MODEL=
# Set to 0 for the final run: manual transcriptions may not stand in for a vision result
MULTIMODAL_ALLOW_MANUAL=

# Live vision calls need an explicit opt-in (set 1) or tools/compare_multimodal.py --run
MULTIMODAL_LIVE=
